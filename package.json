{
  "name": "ff-tools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev --name init",
    "sync:nerds": "tsx src/server/jobs/manualSync.ts dynasty-nerds",
    "sync:calc": "tsx src/server/jobs/manualSync.ts dynasty-calculator",
    "capture:worker": "tsx src/server/jobs/captureWorker.ts",
    "capture:plan": "tsx src/server/jobs/captureWorker.ts --dry-run",
    "players:seed": "tsx src/server/jobs/seedPlayers.ts",
    "players:match": "tsx src/server/jobs/matchPlayers.ts",
    "db:deploy": "node --import tsx scripts/db-deploy.mjs",
    "db:backup": "tsx src/server/jobs/backupDatabase.ts",
    "db:restore": "tsx src/server/jobs/restoreDatabase.ts",
    "db:query": "tsx src/server/jobs/queryDatabase.ts",
    "browser:install": "playwright install chromium",
    "record:dtc": "node scripts/record-provider-flow.mjs dynasty-calculator",
    "record:nerds": "node scripts/record-provider-flow.mjs dynasty-nerds",
    "search:index": "zg index --embedding local/potion-code-16m-v2",
    "search:status": "zg status",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint src tests e2e",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "repo:check": "node scripts/check-repo.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.12",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@types/supertest": "^2.0.16",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "daisyui": "^4.12.14",
    "eslint": "9",
    "eslint-plugin-react-hooks": "5",
    "globals": "16",
    "jest": "^29.7.0",
    "nock": "^13.5.5",
    "playwright": "^1.55.0",
    "postcss": "^8.4.47",
    "prettier": "3",
    "prisma": "^6.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.10",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.13",
    "ts-jest": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "8",
    "vite": "^5.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
