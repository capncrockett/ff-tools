{
  "name": "ff-tools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node scripts/prisma-validate.mjs",
    "prisma:migrate": "prisma migrate dev --name init",
    "sync:nerds": "tsx src/server/jobs/manualSync.ts dynasty-nerds",
    "sync:calc": "tsx src/server/jobs/manualSync.ts dynasty-calculator",
    "capture:worker": "tsx src/server/jobs/captureWorker.ts",
    "capture:plan": "tsx src/server/jobs/captureWorker.ts --dry-run",
    "players:seed": "tsx src/server/jobs/seedPlayers.ts",
    "players:match": "tsx src/server/jobs/matchPlayers.ts",
    "db:deploy": "node --import tsx scripts/db-deploy.mjs",
    "db:backup": "tsx src/server/jobs/backupDatabase.ts",
    "db:restore": "tsx src/server/jobs/restoreDatabase.ts",
    "db:query": "tsx src/server/jobs/queryDatabase.ts",
    "browser:install": "playwright install chromium",
    "record:dtc": "node scripts/record-provider-flow.mjs dynasty-calculator",
    "record:nerds": "node scripts/record-provider-flow.mjs dynasty-nerds",
    "search:index": "zg index --embedding local/potion-code-16m-v2",
    "search:status": "zg status",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint src tests e2e",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "repo:check": "node scripts/check-repo.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^2.0.16",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.0",
    "concurrently": "^9.2.4",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "nock": "^13.5.6",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.10",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=24"
  }
}
