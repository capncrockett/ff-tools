generator client {
  provider = "prisma-client"
  output   = "../src/server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// The unifying table: one row per real player, keyed by Sleeper ID. Each provider catalog row links
/// here at most once, so a player's Dynasty GM and DTC identities meet on this row.
model Player {
  id              Int              @id @default(autoincrement())
  sleeperId       String?          @unique
  name            String
  position        String?
  team            String?
  /// YYYY-MM-DD from Sleeper; corroborates catalog matches.
  birthDate       String?
  createdAt       DateTime         @default(now())
  valuations      Valuation[]
  mappings        Mapping[]
  holdings        Holding[]
  rosterMovements RosterMovement[]
  dynastyGmPlayer DynastyGmPlayer?
  dtcPlayer       DtcPlayer?
}

/// Every QB, RB, WR, TE, and draft pick Dynasty GM lists, refreshed from its initialization
/// response after each successful capture. The league has no other positions. Rows are never deleted.
model DynastyGmPlayer {
  /// Dynasty GM's own player ID.
  id          Int       @id
  firstName   String
  lastName    String
  position    String
  team        String?
  birthDate   String?
  draftYear   Int?
  status      String?
  firstSeenAt DateTime
  lastSeenAt  DateTime
  player      Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerId    Int?      @unique
  /// linked, ambiguous, unmatched, or skipped (a position that is not matched).
  matchStatus String    @default("unmatched")
  /// automatic or manual. Automatic matching never replaces a manual decision.
  matchMethod String?
  matchNote   String    @default("")
  matchedAt   DateTime?

  @@index([matchStatus])
  @@index([position, lastName])
}

/// Every player DTC's QB, RB, WR, and TE ranking exports list. DTC exports carry no player IDs, so
/// the key is the normalized name and position. Rows are never deleted.
model DtcPlayer {
  key           String    @id
  name          String
  position      String
  team          String?
  /// Age as DTC displayed it at ageObservedAt, in years.
  age           Float?
  ageObservedAt DateTime?
  rank          Int?
  firstSeenAt   DateTime
  lastSeenAt    DateTime
  player        Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerId      Int?      @unique
  matchStatus   String    @default("unmatched")
  matchMethod   String?
  matchNote     String    @default("")
  matchedAt     DateTime?

  @@index([matchStatus])
}

model Source {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  notes      String?
  valuations Valuation[]
  mappings   Mapping[]
  snapshots  Snapshot[]
}

model Valuation {
  id         Int       @id @default(autoincrement())
  player     Player    @relation(fields: [playerId], references: [id])
  playerId   Int
  source     Source    @relation(fields: [sourceId], references: [id])
  sourceId   Int
  value      Float
  unit       String    @default("index")
  capturedAt DateTime  @default(now())
  snapshot   Snapshot? @relation(fields: [snapshotId], references: [id])
  snapshotId String?
  contextKey String    @default("legacy-unverified")
  sourceKey  String?

  @@unique([snapshotId, playerId])
  @@index([playerId, sourceId, contextKey, capturedAt])
}

model Mapping {
  id        Int    @id @default(autoincrement())
  source    Source @relation(fields: [sourceId], references: [id])
  sourceId  Int
  sourceKey String // e.g., name or ID used by the source
  player    Player @relation(fields: [playerId], references: [id])
  playerId  Int

  @@unique([sourceId, sourceKey])
}

model Snapshot {
  id          String      @id @default(cuid())
  source      Source      @relation(fields: [sourceId], references: [id])
  sourceId    Int
  contextKey  String
  contextJson String
  capturedAt  DateTime
  importedAt  DateTime    @default(now())
  checksum    String
  rowCount    Int
  method      String
  valuations  Valuation[]

  @@unique([sourceId, contextKey, capturedAt])
  @@index([sourceId, contextKey, capturedAt])
}

model Holding {
  id               String    @id @default(cuid())
  player           Player    @relation(fields: [playerId], references: [id])
  playerId         Int
  sourceName       String
  contextKey       String
  portfolio        String
  acquiredAt       DateTime
  costBasis        Float
  targetRoi        Float     @default(20)
  notes            String    @default("")
  closedAt         DateTime?
  proceeds         Float?
  originMovementId String?
  exitMovementId   String?
  reviewReason     String?
  createdAt        DateTime  @default(now())

  @@unique([originMovementId, sourceName, contextKey])
  @@index([playerId, sourceName, contextKey])
}

model SyncRun {
  id          String    @id @default(cuid())
  sourceName  String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String
  message     String
  saved       Int       @default(0)
  failureCode String?

  @@index([sourceName, startedAt])
}

model RosterSyncState {
  id                String           @id
  leagueId          String
  ownerId           String
  leagueName        String
  rosterId          Int?
  playerIdsJson     String           @default("[]")
  trackingStartedAt DateTime
  initializedAt     DateTime?
  lastCheckedAt     DateTime?
  lastWeek          Int              @default(0)
  status            String           @default("idle")
  message           String           @default("No Sleeper roster check yet.")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  movements         RosterMovement[]

  @@unique([leagueId, ownerId])
}

model RosterMovement {
  id                   String               @id
  rosterSyncState      RosterSyncState      @relation(fields: [rosterSyncStateId], references: [id], onDelete: Cascade)
  rosterSyncStateId    String
  sleeperTransactionId String?
  sleeperPlayerId      String
  player               Player?              @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerId             Int?
  direction            String
  kind                 String
  occurredAt           DateTime
  status               String               @default("pending")
  message              String               @default("")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  resolvedAt           DateTime?
  resolutions          MovementResolution[]

  @@index([rosterSyncStateId, occurredAt])
  @@index([sleeperPlayerId, occurredAt])
}

model MovementResolution {
  id                  String         @id @default(cuid())
  movement            RosterMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  movementId          String
  targetKey           String
  sourceName          String
  contextKey          String
  status              String         @default("pending")
  holdingId           String?
  suggestedValue      Float?
  suggestedCapturedAt DateTime?
  message             String         @default("")
  createdAt           DateTime       @default(now())
  resolvedAt          DateTime?

  @@unique([movementId, targetKey])
  @@index([status, createdAt])
}
