generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id         Int      @id @default(autoincrement())
  sleeperId  String?  @unique
  name       String
  position   String?
  team       String?
  createdAt  DateTime @default(now())
  valuations Valuation[]
  mappings   Mapping[]
  holdings   Holding[]
}

model Source {
  id    Int      @id @default(autoincrement())
  name  String   @unique
  notes String?
  valuations Valuation[]
  mappings   Mapping[]
  snapshots  Snapshot[]
}

model Valuation {
  id         Int      @id @default(autoincrement())
  player     Player   @relation(fields: [playerId], references: [id])
  playerId   Int
  source     Source   @relation(fields: [sourceId], references: [id])
  sourceId   Int
  value      Float
  unit       String   @default("index")
  capturedAt DateTime @default(now())
  snapshot   Snapshot? @relation(fields: [snapshotId], references: [id])
  snapshotId String?
  contextKey String @default("legacy-unverified")
  sourceKey  String?

  @@unique([snapshotId, playerId])
  @@index([playerId, sourceId, contextKey, capturedAt])
}

model Mapping {
  id            Int     @id @default(autoincrement())
  source        Source  @relation(fields: [sourceId], references: [id])
  sourceId      Int
  sourceKey     String  // e.g., name or ID used by the source
  player        Player  @relation(fields: [playerId], references: [id])
  playerId      Int
  @@unique([sourceId, sourceKey])
}

model Snapshot {
  id          String @id @default(cuid())
  source      Source @relation(fields: [sourceId], references: [id])
  sourceId    Int
  contextKey  String
  contextJson String
  capturedAt  DateTime
  importedAt  DateTime @default(now())
  checksum    String
  rowCount    Int
  method      String
  valuations  Valuation[]

  @@unique([sourceId, contextKey, capturedAt])
  @@index([sourceId, contextKey, capturedAt])
}

model Holding {
  id           String @id @default(cuid())
  player       Player @relation(fields: [playerId], references: [id])
  playerId     Int
  sourceName   String
  contextKey   String
  portfolio    String
  acquiredAt   DateTime
  costBasis    Float
  targetRoi    Float @default(20)
  notes        String @default("")
  closedAt     DateTime?
  proceeds     Float?
  createdAt    DateTime @default(now())

  @@index([playerId, sourceName, contextKey])
}

model SyncRun {
  id          String @id @default(cuid())
  sourceName  String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String
  message     String
  saved       Int @default(0)

  @@index([sourceName, startedAt])
}

